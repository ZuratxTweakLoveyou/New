-- Function tạo Toggle
local function createToggle(name, defaultState, callback)
    local btn = Instance.new("TextButton", Container)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
    btn.Text = "  " .. name
    btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 6)

    local statusBox = Instance.new("Frame", btn)
    statusBox.Size = UDim2.fromOffset(50, 24)
    statusBox.Position = UDim2.new(1, -60, 0.5, -12)
    statusBox.BackgroundColor3 = defaultState and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(180, 180, 180)
    
    local boxCorner = Instance.new("UICorner", statusBox)
    boxCorner.CornerRadius = UDim.new(0, 12)

    local statusText = Instance.new("TextLabel", statusBox)
    statusText.Size = UDim2.new(1, 0, 1, 0)
    statusText.Text = defaultState and "BẬT" or "TẮT"
    statusText.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusText.Font = Enum.Font.SourceSansBold
    statusText.TextSize = 12
    statusText.BackgroundTransparency = 1

    local state = defaultState
    btn.MouseButton1Click:Connect(function()
        state = not state
        statusBox.BackgroundColor3 = state and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(180, 180, 180)
        statusText.Text = state and "BẬT" or "TẮT"
        callback(state)
    end)
end

-- Function tạo Input
local function createInput(placeholder, callback)
    local box = Instance.new("TextBox", Container)
    box.Size = UDim2.new(1, 0, 0, 36)
    box.PlaceholderText = placeholder
    box.Text = ""
    box.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    box.TextColor3 = Color3.fromRGB(0, 0, 0)
    box.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
    box.Font = Enum.Font.SourceSansBold
    box.TextSize = 13
    
    local corner = Instance.new("UICorner", box)
    corner.CornerRadius = UDim.new(0, 6)
    
    local stroke = Instance.new("UIStroke", box)
    stroke.Color = Color3.fromRGB(210, 210, 210)
    
    box.FocusLost:Connect(function() callback(box.Text) end)
end

-- BƯỚC 1: FIX CƠ CHẾ 2 NGÓN CHẠM 4 LẦN
local tapCount = 0
local lastTapTime = 0

UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
    local activeTouches = UserInputService:GetTouches()
    if #activeTouches == 2 then
        local currentTime = tick()
        if currentTime - lastTapTime < 0.45 then
            tapCount = tapCount + 1
        else
            tapCount = 1
        end
        lastTapTime = currentTime

        if tapCount >= 4 then
            MainFrame.Visible = not MainFrame.Visible
            tapCount = 0
        end
    end
end)

-- HÀM KIỂM TRA ĐỒNG ĐỘI
local function isTeammate(player)
    if player == LocalPlayer then return true end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
        return true
    end
    if player.TeamColor == LocalPlayer.TeamColor then
        return true
    end
    return false
end

-- 1. AUTO KILL STABLE
createToggle("1. Auto Kill Team Địch", false, function(v) Settings.AutoKill = v end)

task.spawn(function()
    while true do
        if Settings.AutoKill then
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if char and root then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if not tool then
                        local bTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                        if bTool then bTool.Parent = char; tool = bTool end
                    end

                    for _, target in ipairs(Players:GetPlayers()) do
                        if not isTeammate(target) then
                            local tChar = target.Character
                            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

                            if tRoot and tHum and tHum.Health > 0 then
                                root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 1.2)
                                if tool then tool:Activate() end
                                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                task.wait(0.001)
                                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                            end
                        end
                    end
                end
            end)
            task.wait(0.01)
        else
            task.wait(0.2)
        end
    end
end)

-- 2. HITBOX PRO
createToggle("2. Hitbox Pro (Anti-Lag)", false, function(v) Settings.HitboxPro = v end)
createInput("Kích thước Hitbox (Tùy chỉnh vô hạn)...", function(text)
    local val = tonumber(text)
    if val then Settings.HitboxSize = val end
end)

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local pChar = player.Character
            local tRoot = pChar:FindFirstChild("HumanoidRootPart")
            local pHum = pChar:FindFirstChildOfClass("Humanoid")

            if tRoot and pHum then
                local box = tRoot:FindFirstChild("ProHitboxOutline")
                if Settings.HitboxPro and pHum.Health > 0 then
                    if isTeammate(player) then
                        tRoot.Size = Vector3.new(2, 2, 1)
                        if not box then
                            box = Instance.new("SelectionBox")
                            box.Name = "ProHitboxOutline"
                            box.Adornee = tRoot
                            box.Parent = tRoot
                        end
                        box.Color3 = Color3.fromRGB(0, 255, 100)
                    else
                        tRoot.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                        tRoot.Transparency = 0.8
                        tRoot.CanCollide = false

                        if not box then
                            box = Instance.new("SelectionBox")
                            box.Name = "ProHitboxOutline"
                            box.Adornee = tRoot
                            box.Parent = tRoot
                        end

                        if pHum.Health < pHum.MaxHealth then
                            box.Color3 = Color3.fromRGB(255, 0, 0)
                        else
                            box.Color3 = Color3.fromRGB(255, 170, 0)
                        end
                    end
                else
                    tRoot.Size = Vector3.new(2, 2, 1)
                    tRoot.Transparency = 1
                    if box then box:Destroy() end
                end
            end
        end
    end
end)

